<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Credit link, far top right -->
    <TextView
        android:id="@+id/creditLink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="@drawable/bg_link"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp"
        android:text="Created by https://burnsymbol.com"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SUB-ETHA\nOMNIVIEW"
                android:textColor="@color/cyan"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Don't panic. Pick a layout, choose your videos, press play."
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Browse mode: pick a folder, see every video, play one on its own -->
            <TextView
                android:id="@+id/browseBtn"
                style="@style/Chip"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:layout_weight="0"
                android:letterSpacing="0.08"
                android:text="BROWSE VIDEOS"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="2dp"
                android:text="Open a folder and play any single video, with thumbnails and details."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                style="@style/SectionLabel"
                android:text="NUMBER OF VIDEOS" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:id="@+id/chip1" style="@style/Chip" android:text="1" />
                <TextView android:id="@+id/chip2" style="@style/Chip" android:text="2" />
                <TextView android:id="@+id/chip3" style="@style/Chip" android:text="3" />
                <TextView android:id="@+id/chip4" style="@style/Chip" android:text="4" />
            </LinearLayout>

            <com.example.quadplayer.LayoutPreview
                android:id="@+id/preview"
                android:layout_width="240dp"
                android:layout_height="135dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp" />

            <LinearLayout
                android:id="@+id/splitSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionLabel"
                    android:text="LAYOUT" />

                <!-- Filled in by SplashActivity: rows of two layout chips -->
                <LinearLayout
                    android:id="@+id/layoutChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <TextView
                style="@style/SectionLabel"
                android:text="SELECT VIDEOS" />

            <LinearLayout
                android:id="@+id/slots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/startBtn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_primary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:text="START PLAYING"
        android:textColor="@color/primary_text"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
